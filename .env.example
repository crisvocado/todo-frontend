# logcore error reporting. Vite only exposes VITE_-prefixed variables to
# browser code — without the prefix these are absent at runtime and the
# logger silently sends nothing.
VITE_LOGCORE_ENABLED=true
VITE_LOGCORE_URL=https://logcore-dev-t3tg5awmpq-uk.a.run.app
VITE_LOGCORE_KEY=ablog_pub_Yj7ozSI-Xl7Cs9PYFu1JHWjn_pp-AbWArT5h-_HJdIk.eb64c71247b68a77742ee756213c25531467725fa19110223cbea492b56135a1

# Optional. Defaults: env=dev, source_project=""
VITE_LOGCORE_ENV=dev
VITE_LOGCORE_SOURCE_PROJECT=
