# logcore — browser logging via the HTTP gateway.
# Copy to .env.local and fill in. Vite exposes VITE_* vars to the browser bundle,
# so only the publishable (pub) logcore key belongs here.

VITE_LOGCORE_ENDPOINT=https://agents-api-dev-352942961463.us-east4.run.app
VITE_LOGCORE_KEY=ablog_pub_xxx

# Optional — defaults shown.
VITE_LOGCORE_SERVICE=todo-frontend
VITE_LOGCORE_ENV=dev
VITE_LOGCORE_SOURCE_PROJECT=todo-frontend
