# Vite solo expone al navegador las variables con prefijo VITE_. Sin él, el
# cliente no las ve y no envía nada.
VITE_LOGCORE_ENABLED=true
VITE_LOGCORE_URL=https://logcore-dev-t3tg5awmpq-uk.a.run.app
VITE_LOGCORE_KEY=<api_key del servicio en la plataforma>
# Uno de: prod, staging, dev, test, local.
VITE_LOGCORE_ENV=dev
