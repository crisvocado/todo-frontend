# Logcore structured logging.
# Copy to .env.local (git-ignored via *.local) and fill in the key.
# Vite inlines VITE_* vars at build time, so these must be set before `npm run build`.

VITE_LOGCORE_ENDPOINT=https://agents-api-dev-352942961463.us-east4.run.app

# Publishable gateway key for this service. Not committed — see .env.local.
VITE_LOGCORE_KEY=

VITE_LOGCORE_SERVICE=todo-frontend
VITE_LOGCORE_ENV=dev

# Optional. GCP project this app is served from; logcore only uses it to name
# the service in a discard warning, so an empty value is accepted.
VITE_LOGCORE_SOURCE_PROJECT=
