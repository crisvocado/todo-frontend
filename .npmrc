# Private Artifact Registry for @ablock/* (centralized logging / abs_logs) and
# @avocado-blockchain-services/* (issue-tracker SDK) packages. Both live in the
# ablock-npm repo in the logcore project (persea-dev-2).
# Authenticate before install:  npx google-artifactregistry-auth
@ablock:registry=https://us-central1-npm.pkg.dev/persea-dev-2/ablock-npm/
@avocado-blockchain-services:registry=https://us-central1-npm.pkg.dev/persea-dev-2/ablock-npm/
//us-central1-npm.pkg.dev/persea-dev-2/ablock-npm/:always-auth=true
